# Copy this file to `.env` and fill in what you have.
# `.env` is gitignored; this example is not, so never put a real value here.
#
# An exported environment variable takes priority over anything in `.env`.

# Optional. Adds Discogs as a cover source for pressings a commercial
# catalogue skips — obscure releases, vinyl, special editions.
# Generate one at https://www.discogs.com/settings/developers
LYRICA_DISCOGS_TOKEN=

# Optional. Moves the lyrics cache somewhere synchronised between machines.
# LYRICA_CACHE_DIR=C:\Users\you\OneDrive\Lyrica\cache
